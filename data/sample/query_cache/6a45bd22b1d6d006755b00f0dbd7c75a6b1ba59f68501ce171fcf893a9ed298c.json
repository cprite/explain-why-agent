 "source": null,
 "sql": "WITH order_leads AS (\n  SELECT\n    p.product_category_name,\n    CASE\n      WHEN o.order_delivered_customer_date >= DATE '2018-05-28' AND o.order_delivered_customer_date < DATE '2018-06-04' THEN 'window'\n      WHEN o.order_delivered_customer_date >= DATE '2018-05-21' AND o.order_delivered_customer_date < DATE '2018-05-28' THEN 'baseline'\n    END AS period,\n    DATE_DIFF('day', o.order_purchase_timestamp, o.order_delivered_customer_date) AS lead_days\n  FROM orders.orders o\n  JOIN orders.order_items oi ON o.order_id = oi.order_id\n  JOIN orders.products p ON oi.product_id = p.product_id\n  WHERE o.order_status = 'delivered'\n    AND o.order_delivered_customer_date IS NOT NULL\n    AND o.order_purchase_timestamp IS NOT NULL\n    AND (\n      (o.order_delivered_customer_date >= DATE '2018-05-28' AND o.order_delivered_customer_date < DATE '2018-06-04')\n      OR (o.order_delivered_customer_date >= DATE '2018-05-21' AND o.order_delivered_customer_date < DATE '2018-05-28')\n    )\n)\nSELECT\n  product_category_name,\n  ROUND(AVG(CASE WHEN period = 'window' THEN lead_days END), 4) AS value,\n  ROUND(AVG(CASE WHEN period = 'baseline' THEN lead_days END), 4) AS baseline,\n  COUNT(CASE WHEN period = 'window' THEN 1 END) AS window_n,\n  COUNT(CASE WHEN period = 'baseline' THEN 1 END) AS baseline_n\nFROM order_leads\nWHERE period IS NOT NULL\nGROUP BY product_category_name\nORDER BY (value - baseline) DESC NULLS LAST\nLIMIT 50;",
 "truncated": false
}
