 "source": null,
 "sql": "WITH order_payment AS (\n  SELECT order_id, SUM(payment_value) AS order_payment\n  FROM payments.order_payments\n  GROUP BY order_id\n),\nwindow_orders AS (\n  SELECT o.order_id, oi.seller_id, op.order_payment\n  FROM orders.orders o\n  JOIN orders.order_items oi ON oi.order_id = o.order_id\n  JOIN order_payment op ON op.order_id = o.order_id\n  WHERE o.order_purchase_timestamp >= DATE '2017-08-01'\n    AND o.order_purchase_timestamp < DATE '2017-09-01'\n),\nbaseline_orders AS (\n  SELECT o.order_id, oi.seller_id, op.order_payment\n  FROM orders.orders o\n  JOIN orders.order_items oi ON oi.order_id = o.order_id\n  JOIN order_payment op ON op.order_id = o.order_id\n  WHERE o.order_purchase_timestamp >= DATE '2017-07-01'\n    AND o.order_purchase_timestamp < DATE '2017-08-01'\n),\nwindow_seller AS (\n  SELECT seller_id,\n         COUNT(DISTINCT order_id) AS n_orders,\n         SUM(order_payment) AS revenue,\n         AVG(order_payment) AS aov\n  FROM window_orders\n  GROUP BY seller_id\n),\nbaseline_seller AS (\n  SELECT seller_id,\n         COUNT(DISTINCT order_id) AS n_orders,\n         SUM(order_payment) AS revenue,\n         AVG(order_payment) AS aov\n  FROM baseline_orders\n  GROUP BY seller_id\n),\nwindow_totals AS (\n  SELECT SUM(revenue) AS total_revenue, SUM(n_orders) AS total_orders\n  FROM window_seller\n),\nbaseline_totals AS (\n  SELECT SUM(revenue) AS total_revenue, SUM(n_orders) AS total_orders\n  FROM baseline_seller\n)\nSELECT\n  COALESCE(ws.seller_id, bs.seller_id) AS seller_id,\n  s.seller_city,\n  s.seller_state,\n  ws.n_orders AS window_orders,\n  bs.n_orders AS baseline_orders,\n  ROUND(ws.revenue, 2) AS window_revenue,\n  ROUND(bs.revenue, 2) AS baseline_revenue,\n  ROUND(ws.aov, 4) AS window_aov,\n  ROUND(bs.aov, 4) AS baseline_aov,\n  ROUND(ws.revenue / NULLIF(wt.total_revenue, 0), 4) AS window_revenue_share,\n  ROUND(bs.revenue / NULLIF(bt.total_revenue, 0), 4) AS baseline_revenue_share,\n  ROUND(ws.n_orders::DOUBLE / NULLIF(wt.total_orders, 0), 4) AS window_order_share,\n  ROUND(bs.n_orders::DOUBLE / NULLIF(bt.total_orders, 0), 4) AS baseline_order_share\nFROM window_seller ws\nFULL OUTER JOIN baseline_seller bs ON bs.seller_id = ws.seller_id\nLEFT JOIN orders.sellers s ON s.seller_id = COALESCE(ws.seller_id, bs.seller_id)\nCROSS JOIN window_totals wt\nCROSS JOIN baseline_totals bt\nORDER BY baseline_revenue DESC NULLS LAST, window_revenue DESC\nLIMIT 50;",
 "truncated": false
}
