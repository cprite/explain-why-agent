 "source": null,
 "sql": "WITH rj_orders AS (\n  SELECT o.order_id, o.order_purchase_timestamp\n  FROM orders.orders o\n  JOIN orders.customers c ON c.customer_id = o.customer_id\n  WHERE c.customer_state = 'RJ'\n    AND o.order_purchase_timestamp >= DATE '2018-06-01'\n    AND o.order_purchase_timestamp < DATE '2018-07-01'\n),\nwin_orders AS (\n  SELECT order_id\n  FROM rj_orders\n  WHERE order_purchase_timestamp >= DATE '2018-06-12'\n    AND order_purchase_timestamp < DATE '2018-07-01'\n),\nbase_orders AS (\n  SELECT order_id\n  FROM rj_orders\n  WHERE order_purchase_timestamp >= DATE '2018-06-01'\n    AND order_purchase_timestamp < DATE '2018-06-12'\n),\nwin_stats AS (\n  SELECT p.product_category_name AS category,\n         AVG(oi.price) AS avg_price,\n         COUNT(*) AS n_items\n  FROM win_orders w\n  JOIN orders.order_items oi ON oi.order_id = w.order_id\n  JOIN orders.products p ON p.product_id = oi.product_id\n  GROUP BY p.product_category_name\n),\nbase_stats AS (\n  SELECT p.product_category_name AS category,\n         AVG(oi.price) AS avg_price,\n         COUNT(*) AS n_items\n  FROM base_orders b\n  JOIN orders.order_items oi ON oi.order_id = b.order_id\n  JOIN orders.products p ON p.product_id = oi.product_id\n  GROUP BY p.product_category_name\n)\nSELECT\n  COALESCE(w.category, b.category) AS product_category_name,\n  ROUND(w.avg_price, 4) AS value,\n  ROUND(b.avg_price, 4) AS baseline,\n  w.n_items AS window_items,\n  b.n_items AS baseline_items\nFROM win_stats w\nFULL OUTER JOIN base_stats b ON w.category = b.category\nORDER BY ABS(COALESCE(w.avg_price, 0) - COALESCE(b.avg_price, 0)) DESC\nLIMIT 30;",
 "truncated": false
}
