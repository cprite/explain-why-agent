 "source": null,
 "sql": "WITH order_values AS (\n  SELECT\n    o.order_id,\n    CAST(o.order_purchase_timestamp AS DATE) AS order_date,\n    SUM(p.payment_value) AS order_value\n  FROM orders.orders o\n  JOIN payments.order_payments p ON p.order_id = o.order_id\n  GROUP BY o.order_id, CAST(o.order_purchase_timestamp AS DATE)\n),\norder_categories AS (\n  SELECT DISTINCT\n    ov.order_id,\n    ov.order_date,\n    ov.order_value,\n    pc.product_category_name\n  FROM order_values ov\n  JOIN orders.order_items oi ON oi.order_id = ov.order_id\n  JOIN orders.products pc ON pc.product_id = oi.product_id\n),\nwindow_data AS (\n  SELECT *\n  FROM order_categories\n  WHERE order_date >= DATE '2017-08-01' AND order_date < DATE '2017-09-01'\n),\nbaseline_data AS (\n  SELECT *\n  FROM order_categories\n  WHERE order_date >= DATE '2017-07-01' AND order_date < DATE '2017-08-01'\n),\nwindow_stats AS (\n  SELECT\n    product_category_name,\n    COUNT(DISTINCT order_id) AS n_orders,\n    ROUND(SUM(order_value) / COUNT(DISTINCT order_id), 4) AS avg_order_value,\n    ROUND(COUNT(DISTINCT order_id) * 100.0 / (SELECT COUNT(DISTINCT order_id) FROM window_data), 4) AS order_share_pct\n  FROM window_data\n  GROUP BY product_category_name\n),\nbaseline_stats AS (\n  SELECT\n    product_category_name,\n    COUNT(DISTINCT order_id) AS n_orders,\n    ROUND(SUM(order_value) / COUNT(DISTINCT order_id), 4) AS avg_order_value,\n    ROUND(COUNT(DISTINCT order_id) * 100.0 / (SELECT COUNT(DISTINCT order_id) FROM baseline_data), 4) AS order_share_pct\n  FROM baseline_data\n  GROUP BY product_category_name\n)\nSELECT\n  COALESCE(ws.product_category_name, bs.product_category_name) AS product_category_name,\n  ws.n_orders AS window_n_orders,\n  ws.avg_order_value AS window_avg_order_value,\n  ws.order_share_pct AS window_order_share_pct,\n  bs.n_orders AS baseline_n_orders,\n  bs.avg_order_value AS baseline_avg_order_value,\n  bs.order_share_pct AS baseline_order_share_pct,\n  ROUND(ws.order_share_pct - bs.order_share_pct, 4) AS share_change_pct,\n  ROUND(ws.avg_order_value - bs.avg_order_value, 4) AS aov_change\nFROM window_stats ws\nFULL JOIN baseline_stats bs ON ws.product_category_name = bs.product_category_name\nORDER BY ABS(ws.order_share_pct - bs.order_share_pct) DESC NULLS LAST\nLIMIT 50;",
 "truncated": false
}
