 "source": null,
 "sql": "WITH order_payments AS (\n  SELECT order_id, SUM(payment_value) AS order_payment\n  FROM payments.order_payments\n  GROUP BY order_id\n),\norder_categories AS (\n  SELECT order_id, category\n  FROM (\n    SELECT oi.order_id,\n           pct.product_category_name_english AS category,\n           ROW_NUMBER() OVER (PARTITION BY oi.order_id ORDER BY oi.price DESC) AS rn\n    FROM orders.order_items oi\n    JOIN orders.products p ON p.product_id = oi.product_id\n    JOIN orders.product_category_name_translation pct\n      ON pct.product_category_name = p.product_category_name\n  )\n  WHERE rn = 1\n),\norder_segments AS (\n  SELECT o.order_id,\n         CASE WHEN o.order_purchase_timestamp >= DATE '2017-08-01' THEN 'window' ELSE 'baseline' END AS period,\n         COALESCE(oc.category, 'uncategorized') AS category,\n         COALESCE(cs.customer_state, 'unknown') AS customer_state,\n         COALESCE(op.order_payment, 0) AS order_payment\n  FROM orders.orders o\n  LEFT JOIN order_categories oc ON oc.order_id = o.order_id\n  LEFT JOIN orders.customers cs ON cs.customer_id = o.customer_id\n  LEFT JOIN order_payments op ON op.order_id = o.order_id\n  WHERE o.order_purchase_timestamp >= DATE '2017-07-01'\n    AND o.order_purchase_timestamp < DATE '2017-09-01'\n),\nsegment_agg AS (\n  SELECT category, customer_state, period,\n         COUNT(*) AS orders,\n         AVG(order_payment) AS aov\n  FROM order_segments\n  GROUP BY category, customer_state, period\n),\ntotals AS (\n  SELECT\n    SUM(CASE WHEN period = 'window' THEN 1 ELSE 0 END) AS window_n,\n    SUM(CASE WHEN period = 'baseline' THEN 1 ELSE 0 END) AS baseline_n\n  FROM order_segments\n)\nSELECT\n  s.category,\n  s.customer_state,\n  ROUND(SUM(CASE WHEN s.period = 'window' THEN s.orders END)::DOUBLE / t.window_n, 4) AS window_share,\n  ROUND(SUM(CASE WHEN s.period = 'baseline' THEN s.orders END)::DOUBLE / t.baseline_n, 4) AS baseline_share,\n  ROUND(AVG(CASE WHEN s.period = 'window' THEN s.aov END), 4) AS window_aov,\n  ROUND(AVG(CASE WHEN s.period = 'baseline' THEN s.aov END), 4) AS baseline_aov,\n  ROUND(AVG(CASE WHEN s.period = 'window' THEN s.aov END) - AVG(CASE WHEN s.period = 'baseline' THEN s.aov END), 4) AS aov_change,\n  ROUND(SUM(CASE WHEN s.period = 'window' THEN s.orders END)::DOUBLE / t.window_n\n      - SUM(CASE WHEN s.period = 'baseline' THEN s.orders END)::DOUBLE / t.baseline_n, 4) AS share_change\nFROM segment_agg s\nCROSS JOIN totals t\nGROUP BY s.category, s.customer_state, t.window_n, t.baseline_n\nORDER BY aov_change ASC\nLIMIT 40;",
 "truncated": false
}
