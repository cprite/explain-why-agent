 "source": null,
 "sql": "WITH window_orders AS (\n  SELECT DISTINCT o.order_id, oi.seller_id\n  FROM orders.orders o\n  JOIN orders.order_items oi ON o.order_id = oi.order_id\n  WHERE o.order_purchase_timestamp >= DATE '2017-11-24'\n    AND o.order_purchase_timestamp < DATE '2017-11-25'\n),\nbaseline_orders AS (\n  SELECT DISTINCT o.order_id, oi.seller_id\n  FROM orders.orders o\n  JOIN orders.order_items oi ON o.order_id = oi.order_id\n  WHERE o.order_purchase_timestamp >= DATE '2017-11-17'\n    AND o.order_purchase_timestamp < DATE '2017-11-24'\n),\nwindow_counts AS (\n  SELECT seller_id, COUNT(DISTINCT order_id) AS window_orders\n  FROM window_orders\n  GROUP BY seller_id\n),\nbaseline_counts AS (\n  SELECT seller_id, COUNT(DISTINCT order_id) AS baseline_orders\n  FROM baseline_orders\n  GROUP BY seller_id\n)\nSELECT\n  wc.seller_id,\n  wc.window_orders,\n  ROUND(COALESCE(bc.baseline_orders, 0) / 7.0, 4) AS baseline_avg_daily_orders,\n  ROUND(wc.window_orders * 1.0 / NULLIF(COALESCE(bc.baseline_orders, 0) / 7.0, 0), 4) AS spike_ratio\nFROM window_counts wc\nLEFT JOIN baseline_counts bc ON wc.seller_id = bc.seller_id\nORDER BY spike_ratio DESC NULLS LAST\nLIMIT 20;",
 "truncated": false
}
