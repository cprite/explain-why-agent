 "source": null,
 "sql": "WITH base AS (\n  SELECT\n    r.review_score,\n    r.review_creation_date,\n    oi.seller_id\n  FROM reviews.order_reviews AS r\n  JOIN orders.order_items AS oi ON oi.order_id = r.order_id\n  JOIN orders.products AS p ON p.product_id = oi.product_id\n  WHERE p.product_category_name = 'relogios_presentes'\n    AND r.review_creation_date IS NOT NULL\n),\nwin AS (\n  SELECT seller_id, review_score FROM base\n  WHERE review_creation_date >= DATE '2018-01-01' AND review_creation_date < DATE '2018-02-01'\n),\nbl AS (\n  SELECT seller_id, review_score FROM base\n  WHERE review_creation_date >= DATE '2017-12-01' AND review_creation_date < DATE '2018-01-01'\n),\nwin_stats AS (\n  SELECT\n    seller_id,\n    COUNT(*) AS n_window,\n    ROUND(AVG(CAST(review_score AS DOUBLE)), 4) AS avg_window\n  FROM win\n  GROUP BY seller_id\n),\nbl_stats AS (\n  SELECT\n    seller_id,\n    COUNT(*) AS n_baseline,\n    ROUND(AVG(CAST(review_score AS DOUBLE)), 4) AS avg_baseline\n  FROM bl\n  GROUP BY seller_id\n)\nSELECT\n  COALESCE(ws.seller_id, bs.seller_id) AS seller_id,\n  ws.n_window,\n  ROUND(ws.avg_window, 4) AS value,\n  bs.n_baseline,\n  ROUND(bs.avg_baseline, 4) AS baseline,\n  ROUND(ws.avg_window - bs.avg_baseline, 4) AS score_change\nFROM win_stats ws\nFULL JOIN bl_stats bs ON ws.seller_id = bs.seller_id\nORDER BY ABS(ws.avg_window - bs.avg_baseline) DESC NULLS LAST\nLIMIT 30;",
 "truncated": false
}
