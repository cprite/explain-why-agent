 "source": null,
 "sql": "WITH order_payments AS (\n  SELECT order_id, SUM(payment_value) AS order_payment\n  FROM payments.order_payments\n  GROUP BY order_id\n),\nrj_window_orders AS (\n  SELECT DISTINCT o.order_id, oi.seller_id\n  FROM orders.orders o\n  JOIN orders.customers c ON c.customer_id = o.customer_id\n  JOIN orders.order_items oi ON oi.order_id = o.order_id\n  WHERE c.customer_state = 'RJ'\n    AND o.order_purchase_timestamp >= DATE '2018-06-12'\n    AND o.order_purchase_timestamp < DATE '2018-07-01'\n),\nrj_baseline_orders AS (\n  SELECT DISTINCT o.order_id, oi.seller_id\n  FROM orders.orders o\n  JOIN orders.customers c ON c.customer_id = o.customer_id\n  JOIN orders.order_items oi ON oi.order_id = o.order_id\n  WHERE c.customer_state = 'RJ'\n    AND o.order_purchase_timestamp >= DATE '2018-06-01'\n    AND o.order_purchase_timestamp < DATE '2018-06-12'\n),\nwindow_seller_stats AS (\n  SELECT rwo.seller_id,\n         AVG(op.order_payment) AS avg_payment,\n         COUNT(*) AS n_orders\n  FROM rj_window_orders rwo\n  JOIN order_payments op ON op.order_id = rwo.order_id\n  GROUP BY rwo.seller_id\n),\nbaseline_seller_stats AS (\n  SELECT rbo.seller_id,\n         AVG(op.order_payment) AS avg_payment,\n         COUNT(*) AS n_orders\n  FROM rj_baseline_orders rbo\n  JOIN order_payments op ON op.order_id = rbo.order_id\n  GROUP BY rbo.seller_id\n)\nSELECT\n  COALESCE(w.seller_id, b.seller_id) AS seller_id,\n  ROUND(w.avg_payment, 4) AS value,\n  ROUND(b.avg_payment, 4) AS baseline,\n  w.n_orders AS window_orders,\n  b.n_orders AS baseline_orders\nFROM window_seller_stats w\nFULL OUTER JOIN baseline_seller_stats b ON w.seller_id = b.seller_id\nORDER BY ABS(COALESCE(w.avg_payment, 0) - COALESCE(b.avg_payment, 0)) DESC\nLIMIT 30;",
 "truncated": false
}
