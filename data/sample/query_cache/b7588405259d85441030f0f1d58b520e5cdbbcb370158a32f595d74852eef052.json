 "source": null,
 "sql": "WITH filtered AS (\n  SELECT r.review_id,\n         p.product_id,\n         CASE\n           WHEN r.review_creation_date >= DATE '2018-01-01' AND r.review_creation_date < DATE '2018-02-01' THEN 'window'\n           WHEN r.review_creation_date >= DATE '2017-12-01' AND r.review_creation_date < DATE '2018-01-01' THEN 'baseline'\n         END AS period\n  FROM reviews.order_reviews AS r\n  JOIN orders.order_items AS oi ON oi.order_id = r.order_id\n  JOIN orders.products AS p ON p.product_id = oi.product_id\n  WHERE p.product_category_name = 'relogios_presentes'\n    AND r.review_creation_date IS NOT NULL\n    AND (\n      (r.review_creation_date >= DATE '2018-01-01' AND r.review_creation_date < DATE '2018-02-01')\n      OR (r.review_creation_date >= DATE '2017-12-01' AND r.review_creation_date < DATE '2018-01-01')\n    )\n),\nproduct_counts AS (\n  SELECT product_id,\n         period,\n         COUNT(*) AS cnt\n  FROM filtered\n  GROUP BY product_id, period\n),\nperiod_totals AS (\n  SELECT period,\n         COUNT(*) AS total_cnt\n  FROM filtered\n  GROUP BY period\n),\nshares AS (\n  SELECT fc.product_id,\n         fc.period,\n         ROUND(fc.cnt::DOUBLE / pt.total_cnt, 4) AS share\n  FROM product_counts fc\n  JOIN period_totals pt ON pt.period = fc.period\n)\nSELECT product_id,\n       MAX(CASE WHEN period = 'window' THEN share END) AS value,\n       MAX(CASE WHEN period = 'baseline' THEN share END) AS baseline,\n       ROUND(MAX(CASE WHEN period = 'window' THEN share END) - MAX(CASE WHEN period = 'baseline' THEN share END), 4) AS share_change\nFROM shares\nGROUP BY product_id\nORDER BY ABS(share_change) DESC\nLIMIT 30;",
 "truncated": false
}
