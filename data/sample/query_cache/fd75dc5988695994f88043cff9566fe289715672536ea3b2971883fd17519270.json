 "source": null,
 "sql": "WITH base AS (\n  SELECT\n    r.review_score,\n    r.review_creation_date,\n    p.product_id\n  FROM reviews.order_reviews r\n  JOIN orders.order_items oi ON r.order_id = oi.order_id\n  JOIN orders.products p ON oi.product_id = p.product_id\n  WHERE p.product_category_name = 'relogios_presentes'\n),\nwindow_reviews AS (\n  SELECT product_id, review_score FROM base\n  WHERE review_creation_date >= DATE '2018-01-01' AND review_creation_date < DATE '2018-02-01'\n),\nbaseline_reviews AS (\n  SELECT product_id, review_score FROM base\n  WHERE review_creation_date >= DATE '2017-12-01' AND review_creation_date < DATE '2018-01-01'\n),\nwindow_agg AS (\n  SELECT\n    product_id,\n    COUNT(*) AS n_window,\n    ROUND(AVG(CAST(review_score AS DOUBLE)), 4) AS avg_window\n  FROM window_reviews\n  GROUP BY product_id\n),\nbaseline_agg AS (\n  SELECT\n    product_id,\n    COUNT(*) AS n_baseline,\n    ROUND(AVG(CAST(review_score AS DOUBLE)), 4) AS avg_baseline\n  FROM baseline_reviews\n  GROUP BY product_id\n)\nSELECT\n  COALESCE(wa.product_id, ba.product_id) AS product_id,\n  wa.n_window,\n  wa.avg_window AS value,\n  ba.n_baseline,\n  ba.avg_baseline AS baseline,\n  ROUND(wa.avg_window - ba.avg_baseline, 4) AS score_change\nFROM window_agg wa\nFULL JOIN baseline_agg ba ON wa.product_id = ba.product_id\nORDER BY ABS(score_change) DESC NULLS LAST\nLIMIT 50;",
 "truncated": false
}
