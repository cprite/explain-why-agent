 "source": null,
 "sql": "WITH rj_items AS (\n  SELECT\n    oi.freight_value,\n    o.order_purchase_timestamp,\n    p.product_category_name\n  FROM orders.order_items oi\n  JOIN orders.orders o ON oi.order_id = o.order_id\n  JOIN orders.customers c ON o.customer_id = c.customer_id\n  JOIN orders.products p ON oi.product_id = p.product_id\n  WHERE c.customer_state = 'RJ'\n    AND o.order_purchase_timestamp >= DATE '2018-07-01'\n    AND o.order_purchase_timestamp < DATE '2018-09-01'\n)\nSELECT\n  product_category_name,\n  ROUND(AVG(CASE WHEN order_purchase_timestamp >= DATE '2018-08-01' THEN freight_value END), 4) AS value,\n  ROUND(AVG(CASE WHEN order_purchase_timestamp < DATE '2018-08-01' THEN freight_value END), 4) AS baseline,\n  COUNT(CASE WHEN order_purchase_timestamp >= DATE '2018-08-01' THEN 1 END) AS window_items,\n  COUNT(CASE WHEN order_purchase_timestamp < DATE '2018-08-01' THEN 1 END) AS baseline_items\nFROM rj_items\nGROUP BY product_category_name\nORDER BY ABS(\n  AVG(CASE WHEN order_purchase_timestamp >= DATE '2018-08-01' THEN freight_value END) -\n  AVG(CASE WHEN order_purchase_timestamp < DATE '2018-08-01' THEN freight_value END)\n) DESC\nLIMIT 20;",
 "truncated": false
}
