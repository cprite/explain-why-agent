 "source": null,
 "sql": "WITH rj_items AS (\n  SELECT\n    oi.freight_value,\n    o.order_purchase_timestamp,\n    p.product_category_name,\n    CASE\n      WHEN o.order_purchase_timestamp >= DATE '2018-08-01' AND o.order_purchase_timestamp < DATE '2018-09-01' THEN 'window'\n      WHEN o.order_purchase_timestamp >= DATE '2018-07-01' AND o.order_purchase_timestamp < DATE '2018-08-01' THEN 'baseline'\n    END AS period\n  FROM orders.order_items oi\n  JOIN orders.orders o ON oi.order_id = o.order_id\n  JOIN orders.customers c ON o.customer_id = c.customer_id\n  JOIN orders.products p ON oi.product_id = p.product_id\n  WHERE c.customer_state = 'RJ'\n    AND o.order_purchase_timestamp >= DATE '2018-07-01'\n    AND o.order_purchase_timestamp < DATE '2018-09-01'\n),\ncat_stats AS (\n  SELECT\n    product_category_name,\n    period,\n    COUNT(*) AS n_items,\n    AVG(freight_value) AS avg_freight\n  FROM rj_items\n  WHERE period IS NOT NULL\n  GROUP BY product_category_name, period\n),\ntotals AS (\n  SELECT\n    period,\n    COUNT(*) AS total_items\n  FROM rj_items\n  WHERE period IS NOT NULL\n  GROUP BY period\n),\ncat_pivot AS (\n  SELECT\n    product_category_name,\n    MAX(CASE WHEN period = 'window' THEN n_items END) AS window_items,\n    MAX(CASE WHEN period = 'baseline' THEN n_items END) AS baseline_items,\n    MAX(CASE WHEN period = 'window' THEN avg_freight END) AS value,\n    MAX(CASE WHEN period = 'baseline' THEN avg_freight END) AS baseline\n  FROM cat_stats\n  GROUP BY product_category_name\n)\nSELECT\n  cp.product_category_name,\n  cp.window_items,\n  cp.baseline_items,\n  ROUND(CAST(cp.window_items AS DOUBLE) / wt.total_items, 4) AS window_share,\n  ROUND(CAST(cp.baseline_items AS DOUBLE) / bt.total_items, 4) AS baseline_share,\n  ROUND(cp.value, 4) AS value,\n  ROUND(cp.baseline, 4) AS baseline,\n  ROUND(cp.value - cp.baseline, 4) AS freight_diff\nFROM cat_pivot cp\nCROSS JOIN (SELECT total_items FROM totals WHERE period = 'window') wt\nCROSS JOIN (SELECT total_items FROM totals WHERE period = 'baseline') bt\nORDER BY ABS(cp.value - cp.baseline) DESC NULLS LAST, cp.window_items DESC\nLIMIT 50;",
 "truncated": false
}
