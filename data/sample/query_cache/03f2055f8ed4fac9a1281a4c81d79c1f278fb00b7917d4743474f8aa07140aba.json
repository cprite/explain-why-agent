 "source": null,
 "sql": "WITH rj_orders AS (\n    SELECT o.order_id, o.order_purchase_timestamp\n    FROM orders.orders o\n    JOIN orders.customers c ON c.customer_id = o.customer_id\n    WHERE c.customer_state = 'RJ'\n      AND o.order_purchase_timestamp >= DATE '2018-06-01'\n      AND o.order_purchase_timestamp < DATE '2018-07-01'\n),\norder_seller AS (\n    SELECT DISTINCT ro.order_id, ro.order_purchase_timestamp, oi.seller_id\n    FROM rj_orders ro\n    JOIN orders.order_items oi ON oi.order_id = ro.order_id\n),\norder_payment AS (\n    SELECT os.order_id, os.order_purchase_timestamp, os.seller_id,\n           SUM(p.payment_value) AS order_payment\n    FROM order_seller os\n    JOIN payments.order_payments p ON p.order_id = os.order_id\n    GROUP BY os.order_id, os.order_purchase_timestamp, os.seller_id\n),\nperiods AS (\n    SELECT op.*,\n           CASE\n               WHEN op.order_purchase_timestamp >= DATE '2018-06-12' AND op.order_purchase_timestamp < DATE '2018-07-01' THEN 'window'\n               WHEN op.order_purchase_timestamp >= DATE '2018-06-01' AND op.order_purchase_timestamp < DATE '2018-06-12' THEN 'baseline'\n           END AS period\n    FROM order_payment op\n),\nseller_period AS (\n    SELECT seller_id, period,\n           COUNT(DISTINCT order_id) AS n_orders,\n           SUM(order_payment) AS revenue,\n           AVG(order_payment) AS aov\n    FROM periods\n    GROUP BY seller_id, period\n),\nseller_pivot AS (\n    SELECT seller_id,\n           MAX(CASE WHEN period = 'window' THEN n_orders END) AS window_orders,\n           MAX(CASE WHEN period = 'baseline' THEN n_orders END) AS baseline_orders,\n           MAX(CASE WHEN period = 'window' THEN revenue END) AS window_revenue,\n           MAX(CASE WHEN period = 'baseline' THEN revenue END) AS baseline_revenue,\n           MAX(CASE WHEN period = 'window' THEN aov END) AS window_aov,\n           MAX(CASE WHEN period = 'baseline' THEN aov END) AS baseline_aov\n    FROM seller_period\n    GROUP BY seller_id\n),\nperiod_totals AS (\n    SELECT period, SUM(revenue) AS total_revenue, SUM(n_orders) AS total_orders\n    FROM seller_period\n    GROUP BY period\n),\ntotals_pivot AS (\n    SELECT\n        MAX(CASE WHEN period = 'window' THEN total_revenue END) AS window_total_revenue,\n        MAX(CASE WHEN period = 'baseline' THEN total_revenue END) AS baseline_total_revenue,\n        MAX(CASE WHEN period = 'window' THEN total_orders END) AS window_total_orders,\n        MAX(CASE WHEN period = 'baseline' THEN total_orders END) AS baseline_total_orders\n    FROM period_totals\n)\nSELECT sp.seller_id,\n       s.seller_city,\n       s.seller_state,\n       sp.window_orders,\n       sp.baseline_orders,\n       ROUND(sp.window_revenue, 2) AS window_revenue,\n       ROUND(sp.baseline_revenue, 2) AS baseline_revenue,\n       ROUND(sp.window_aov, 4) AS window_aov,\n       ROUND(sp.baseline_aov, 4) AS baseline_aov,\n       ROUND(sp.window_revenue / NULLIF(tp.window_total_revenue, 0), 4) AS window_revenue_share,\n       ROUND(sp.baseline_revenue / NULLIF(tp.baseline_total_revenue, 0), 4) AS baseline_revenue_share,\n       ROUND(sp.window_orders::DOUBLE / NULLIF(tp.window_total_orders, 0), 4) AS window_order_share,\n       ROUND(sp.baseline_orders::DOUBLE / NULLIF(tp.baseline_total_orders, 0), 4) AS baseline_order_share,\n       ROUND(sp.window_revenue - sp.baseline_revenue, 2) AS revenue_diff\nFROM seller_pivot sp\nLEFT JOIN orders.sellers s ON s.seller_id = sp.seller_id\nCROSS JOIN totals_pivot tp\nWHERE sp.window_revenue IS NOT NULL OR sp.baseline_revenue IS NOT NULL\nORDER BY COALESCE(sp.baseline_revenue, 0) DESC, COALESCE(sp.window_revenue, 0) DESC\nLIMIT 30;",
 "truncated": false
}
