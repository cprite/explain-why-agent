 "source": null,
 "sql": "WITH rj_base AS (\n   SELECT\n     oi.seller_id,\n     oi.freight_value,\n     o.order_purchase_timestamp\n   FROM orders.order_items oi\n   JOIN orders.orders o ON oi.order_id = o.order_id\n   JOIN orders.customers c ON o.customer_id = c.customer_id\n   WHERE c.customer_state = 'RJ'\n     AND o.order_purchase_timestamp >= DATE '2018-07-01'\n     AND o.order_purchase_timestamp < DATE '2018-09-01'\n),\nwindow_stats AS (\n   SELECT\n     seller_id,\n     COUNT(*) AS window_items,\n     AVG(freight_value) AS window_avg_freight\n   FROM rj_base\n   WHERE order_purchase_timestamp >= DATE '2018-08-01'\n     AND order_purchase_timestamp < DATE '2018-09-01'\n   GROUP BY seller_id\n),\nbaseline_stats AS (\n   SELECT\n     seller_id,\n     COUNT(*) AS baseline_items,\n     AVG(freight_value) AS baseline_avg_freight\n   FROM rj_base\n   WHERE order_purchase_timestamp >= DATE '2018-07-01'\n     AND order_purchase_timestamp < DATE '2018-08-01'\n   GROUP BY seller_id\n),\nwindow_total AS (\n   SELECT COUNT(*) AS total_items FROM rj_base\n   WHERE order_purchase_timestamp >= DATE '2018-08-01'\n     AND order_purchase_timestamp < DATE '2018-09-01'\n),\nbaseline_total AS (\n   SELECT COUNT(*) AS total_items FROM rj_base\n   WHERE order_purchase_timestamp >= DATE '2018-07-01'\n     AND order_purchase_timestamp < DATE '2018-08-01'\n)\nSELECT\n   COALESCE(w.seller_id, b.seller_id) AS seller_id,\n   COALESCE(w.window_items, 0) AS window_items,\n   COALESCE(b.baseline_items, 0) AS baseline_items,\n   ROUND(COALESCE(w.window_items, 0)::DOUBLE / wt.total_items, 4) AS window_share,\n   ROUND(COALESCE(b.baseline_items, 0)::DOUBLE / bt.total_items, 4) AS baseline_share,\n   ROUND(w.window_avg_freight, 4) AS value,\n   ROUND(b.baseline_avg_freight, 4) AS baseline,\n   ROUND(w.window_avg_freight - b.baseline_avg_freight, 4) AS freight_diff\nFROM window_stats w\nFULL OUTER JOIN baseline_stats b ON w.seller_id = b.seller_id\nCROSS JOIN window_total wt\nCROSS JOIN baseline_total bt\nORDER BY COALESCE(w.window_items, 0) DESC\nLIMIT 50;",
 "truncated": false
}
