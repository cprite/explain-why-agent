 "source": null,
 "sql": "WITH window_orders AS (\n  SELECT oi.seller_id, COUNT(DISTINCT o.order_id) AS window_orders\n  FROM orders.orders o\n  JOIN orders.order_items oi ON o.order_id = oi.order_id\n  WHERE o.order_purchase_timestamp >= DATE '2017-11-24'\n    AND o.order_purchase_timestamp < DATE '2017-11-25'\n  GROUP BY oi.seller_id\n),\nbaseline_orders AS (\n  SELECT oi.seller_id, COUNT(DISTINCT o.order_id) AS baseline_orders\n  FROM orders.orders o\n  JOIN orders.order_items oi ON o.order_id = oi.order_id\n  WHERE o.order_purchase_timestamp >= DATE '2017-11-17'\n    AND o.order_purchase_timestamp < DATE '2017-11-24'\n  GROUP BY oi.seller_id\n),\ncombined AS (\n  SELECT\n    COALESCE(w.seller_id, b.seller_id) AS seller_id,\n    COALESCE(w.window_orders, 0) AS window_orders,\n    COALESCE(b.baseline_orders, 0) AS baseline_orders,\n    COALESCE(w.window_orders, 0) - COALESCE(b.baseline_orders, 0) AS extra_orders\n  FROM window_orders w\n  FULL OUTER JOIN baseline_orders b ON w.seller_id = b.seller_id\n),\ntotal_extra AS (\n  SELECT SUM(extra_orders) AS total_extra FROM combined WHERE extra_orders > 0\n)\nSELECT\n  c.seller_id,\n  c.window_orders,\n  c.baseline_orders,\n  c.extra_orders,\n  ROUND(c.extra_orders::DOUBLE / t.total_extra, 4) AS share_of_total_extra\nFROM combined c, total_extra t\nWHERE c.extra_orders > 0\nORDER BY c.extra_orders DESC\nLIMIT 20;",
 "truncated": false
}
