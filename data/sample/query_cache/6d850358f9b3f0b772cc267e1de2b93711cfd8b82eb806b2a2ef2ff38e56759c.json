 "source": null,
 "sql": "WITH base AS (\n  SELECT\n    r.review_creation_date,\n    p.product_id\n  FROM reviews.order_reviews AS r\n  JOIN orders.order_items AS oi ON oi.order_id = r.order_id\n  JOIN orders.products AS p ON p.product_id = oi.product_id\n  WHERE p.product_category_name = 'relogios_presentes'\n    AND r.review_creation_date IS NOT NULL\n),\nwindow_reviews AS (\n  SELECT product_id FROM base\n  WHERE review_creation_date >= DATE '2018-01-01' AND review_creation_date < DATE '2018-02-01'\n),\nbaseline_reviews AS (\n  SELECT product_id FROM base\n  WHERE review_creation_date >= DATE '2017-12-01' AND review_creation_date < DATE '2018-01-01'\n),\nwindow_counts AS (\n  SELECT product_id, COUNT(*) AS n_window FROM window_reviews GROUP BY product_id\n),\nbaseline_counts AS (\n  SELECT product_id, COUNT(*) AS n_baseline FROM baseline_reviews GROUP BY product_id\n),\nwindow_total AS (\n  SELECT COUNT(*) AS total_window FROM window_reviews\n),\nbaseline_total AS (\n  SELECT COUNT(*) AS total_baseline FROM baseline_reviews\n)\nSELECT\n  COALESCE(wc.product_id, bc.product_id) AS product_id,\n  wc.n_window,\n  bc.n_baseline,\n  ROUND(wc.n_window::DOUBLE / wt.total_window, 4) AS window_share,\n  ROUND(bc.n_baseline::DOUBLE / bt.total_baseline, 4) AS baseline_share,\n  ROUND(wc.n_window::DOUBLE / wt.total_window - bc.n_baseline::DOUBLE / bt.total_baseline, 4) AS share_change\nFROM window_counts wc\nFULL JOIN baseline_counts bc ON wc.product_id = bc.product_id\nCROSS JOIN window_total wt\nCROSS JOIN baseline_total bt\nORDER BY ABS(share_change) DESC NULLS LAST\nLIMIT 50;",
 "truncated": false
}
