 "source": null,
 "sql": "WITH delivered_orders AS (\n  SELECT DISTINCT\n    o.order_id,\n    oi.seller_id,\n    o.order_delivered_customer_date,\n    o.order_estimated_delivery_date\n  FROM orders.orders o\n  JOIN orders.order_items oi ON o.order_id = oi.order_id\n  WHERE o.order_status = 'delivered'\n    AND o.order_delivered_customer_date IS NOT NULL\n    AND o.order_estimated_delivery_date IS NOT NULL\n),\nlabeled AS (\n  SELECT\n    seller_id,\n    CASE\n      WHEN order_delivered_customer_date >= DATE '2018-05-28' AND order_delivered_customer_date < DATE '2018-06-04' THEN 'window'\n      WHEN order_delivered_customer_date >= DATE '2018-05-21' AND order_delivered_customer_date < DATE '2018-05-28' THEN 'baseline'\n    END AS period,\n    CASE WHEN order_delivered_customer_date > order_estimated_delivery_date THEN 1 ELSE 0 END AS is_late\n  FROM delivered_orders\n  WHERE order_delivered_customer_date >= DATE '2018-05-21'\n    AND order_delivered_customer_date < DATE '2018-06-04'\n),\naggregated AS (\n  SELECT\n    seller_id,\n    period,\n    COUNT(*) AS completed,\n    SUM(is_late) AS late_count\n  FROM labeled\n  WHERE period IS NOT NULL\n  GROUP BY seller_id, period\n),\npivoted AS (\n  SELECT\n    seller_id,\n    MAX(CASE WHEN period = 'window' THEN completed END) AS window_completed,\n    MAX(CASE WHEN period = 'baseline' THEN completed END) AS baseline_completed,\n    MAX(CASE WHEN period = 'window' THEN late_count END) AS window_late,\n    MAX(CASE WHEN period = 'baseline' THEN late_count END) AS baseline_late\n  FROM aggregated\n  GROUP BY seller_id\n)\nSELECT\n  seller_id,\n  window_completed,\n  baseline_completed,\n  window_late,\n  baseline_late,\n  ROUND(CAST(window_late AS DOUBLE) / NULLIF(window_completed, 0), 4) AS value,\n  ROUND(CAST(baseline_late AS DOUBLE) / NULLIF(baseline_completed, 0), 4) AS baseline,\n  ROUND(CAST(window_late AS DOUBLE) / NULLIF(window_completed, 0) - CAST(baseline_late AS DOUBLE) / NULLIF(baseline_completed, 0), 4) AS diff\nFROM pivoted\nWHERE window_completed IS NOT NULL\nORDER BY ABS(diff) DESC, window_completed DESC\nLIMIT 30;",
 "truncated": false
