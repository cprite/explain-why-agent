 "source": null,
 "sql": "WITH window_stats AS (\n  SELECT\n    oi.seller_id,\n    COUNT(DISTINCT o.order_id) AS window_completed,\n    COUNT(DISTINCT CASE WHEN o.order_delivered_customer_date > o.order_estimated_delivery_date THEN o.order_id END) AS window_late\n  FROM orders.orders AS o\n  JOIN orders.order_items AS oi ON oi.order_id = o.order_id\n  WHERE o.order_status = 'delivered'\n    AND o.order_delivered_customer_date >= DATE '2018-05-28'\n    AND o.order_delivered_customer_date < DATE '2018-06-04'\n  GROUP BY oi.seller_id\n),\nbaseline_stats AS (\n  SELECT\n    oi.seller_id,\n    COUNT(DISTINCT o.order_id) AS baseline_completed,\n    COUNT(DISTINCT CASE WHEN o.order_delivered_customer_date > o.order_estimated_delivery_date THEN o.order_id END) AS baseline_late\n  FROM orders.orders AS o\n  JOIN orders.order_items AS oi ON oi.order_id = o.order_id\n  WHERE o.order_status = 'delivered'\n    AND o.order_delivered_customer_date >= DATE '2018-05-21'\n    AND o.order_delivered_customer_date < DATE '2018-05-28'\n  GROUP BY oi.seller_id\n),\ncombined AS (\n  SELECT\n    COALESCE(w.seller_id, b.seller_id) AS seller_id,\n    COALESCE(w.window_completed, 0) AS window_completed,\n    COALESCE(b.baseline_completed, 0) AS baseline_completed,\n    COALESCE(w.window_late, 0) AS window_late,\n    COALESCE(b.baseline_late, 0) AS baseline_late\n  FROM window_stats AS w\n  FULL OUTER JOIN baseline_stats AS b ON w.seller_id = b.seller_id\n)\nSELECT\n  seller_id,\n  window_completed,\n  baseline_completed,\n  window_late,\n  baseline_late,\n  ROUND(window_late::DOUBLE / NULLIF(window_completed, 0), 4) AS window_late_share,\n  ROUND(baseline_late::DOUBLE / NULLIF(baseline_completed, 0), 4) AS baseline_late_share\nFROM combined\nORDER BY window_completed DESC\nLIMIT 20;",
 "truncated": false
}
