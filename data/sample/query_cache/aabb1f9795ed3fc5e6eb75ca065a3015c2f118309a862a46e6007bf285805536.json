 "source": null,
 "sql": "WITH order_late AS (\n  SELECT\n    o.order_id,\n    CASE\n      WHEN o.order_delivered_customer_date >= DATE '2018-05-28' AND o.order_delivered_customer_date < DATE '2018-06-04' THEN 'window'\n      WHEN o.order_delivered_customer_date >= DATE '2018-05-21' AND o.order_delivered_customer_date < DATE '2018-05-28' THEN 'baseline'\n    END AS period,\n    CASE WHEN o.order_delivered_customer_date > o.order_estimated_delivery_date THEN 1 ELSE 0 END AS is_late\n  FROM orders.orders o\n  WHERE o.order_status = 'delivered'\n    AND o.order_delivered_customer_date IS NOT NULL\n    AND o.order_estimated_delivery_date IS NOT NULL\n    AND o.order_delivered_customer_date >= DATE '2018-05-21'\n    AND o.order_delivered_customer_date < DATE '2018-06-04'\n),\norder_category AS (\n  SELECT DISTINCT\n    ol.order_id,\n    ol.period,\n    ol.is_late,\n    p.product_category_name\n  FROM order_late ol\n  JOIN orders.order_items oi ON oi.order_id = ol.order_id\n  JOIN orders.products p ON p.product_id = oi.product_id\n  WHERE ol.period IS NOT NULL\n),\nagg AS (\n  SELECT\n    product_category_name,\n    period,\n    COUNT(*) AS completed,\n    SUM(is_late) AS late_count\n  FROM order_category\n  GROUP BY product_category_name, period\n),\ncategory_pivot AS (\n  SELECT\n    product_category_name,\n    MAX(CASE WHEN period = 'window' THEN completed END) AS window_completed,\n    MAX(CASE WHEN period = 'baseline' THEN completed END) AS baseline_completed,\n    MAX(CASE WHEN period = 'window' THEN late_count END) AS window_late,\n    MAX(CASE WHEN period = 'baseline' THEN late_count END) AS baseline_late\n  FROM agg\n  GROUP BY product_category_name\n)\nSELECT\n  product_category_name,\n  window_completed,\n  baseline_completed,\n  window_late,\n  baseline_late,\n  ROUND(CAST(window_late AS DOUBLE) / NULLIF(window_completed, 0), 4) AS value,\n  ROUND(CAST(baseline_late AS DOUBLE) / NULLIF(baseline_completed, 0), 4) AS baseline,\n  ROUND(CAST(window_late AS DOUBLE) / NULLIF(window_completed, 0) - CAST(baseline_late AS DOUBLE) / NULLIF(baseline_completed, 0), 4) AS diff\nFROM category_pivot\nWHERE window_completed IS NOT NULL\nORDER BY ABS(diff) DESC, window_completed DESC\nLIMIT 30;",
 "truncated": false
