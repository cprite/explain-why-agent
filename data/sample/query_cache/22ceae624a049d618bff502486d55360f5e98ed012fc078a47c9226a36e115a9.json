 "source": null,
 "sql": "WITH rel_order_seller AS (\n  SELECT oi.order_id, MIN(oi.seller_id) AS seller_id\n  FROM orders.order_items oi\n  JOIN orders.products p ON p.product_id = oi.product_id\n  WHERE p.product_category_name = 'relogios_presentes'\n  GROUP BY oi.order_id\n),\nrel_reviews AS (\n  SELECT r.review_score, r.review_creation_date, ros.seller_id\n  FROM reviews.order_reviews r\n  JOIN rel_order_seller ros ON ros.order_id = r.order_id\n  WHERE r.review_score IS NOT NULL\n),\nwindow_stats AS (\n  SELECT seller_id,\n         ROUND(AVG(review_score)::DOUBLE, 4) AS value,\n         COUNT(*) AS n_window\n  FROM rel_reviews\n  WHERE review_creation_date >= DATE '2018-01-01'\n    AND review_creation_date < DATE '2018-02-01'\n  GROUP BY seller_id\n),\nbaseline_stats AS (\n  SELECT seller_id,\n         ROUND(AVG(review_score)::DOUBLE, 4) AS baseline,\n         COUNT(*) AS n_baseline\n  FROM rel_reviews\n  WHERE review_creation_date >= DATE '2017-12-01'\n    AND review_creation_date < DATE '2018-01-01'\n  GROUP BY seller_id\n)\nSELECT\n  w.seller_id,\n  w.value,\n  b.baseline,\n  ROUND(w.value - b.baseline, 4) AS diff,\n  w.n_window,\n  b.n_baseline\nFROM window_stats w\nJOIN baseline_stats b ON b.seller_id = w.seller_id\nORDER BY ABS(w.value - b.baseline) DESC, w.n_window DESC\nLIMIT 30;",
 "truncated": false
}
