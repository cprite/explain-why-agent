 "source": null,
 "sql": "WITH mg_payments AS (\n  SELECT\n    CAST(o.order_purchase_timestamp AS DATE) AS order_date,\n    p.payment_type,\n    CASE\n      WHEN o.order_purchase_timestamp >= DATE '2018-02-01' AND o.order_purchase_timestamp < DATE '2018-03-01' THEN 'baseline'\n      WHEN o.order_purchase_timestamp >= DATE '2018-03-01' AND o.order_purchase_timestamp < DATE '2018-04-01' THEN 'window'\n    END AS period\n  FROM payments.order_payments AS p\n  JOIN orders.orders AS o ON o.order_id = p.order_id\n  JOIN orders.customers AS c ON c.customer_id = o.customer_id\n  WHERE c.customer_state = 'MG'\n    AND o.order_purchase_timestamp >= DATE '2018-02-01'\n    AND o.order_purchase_timestamp < DATE '2018-04-01'\n)\nSELECT\n  period,\n  order_date,\n  COUNT(*) AS total_payments,\n  SUM(CASE WHEN payment_type = 'boleto' THEN 1 ELSE 0 END) AS boleto_payments,\n  ROUND(SUM(CASE WHEN payment_type = 'boleto' THEN 1 ELSE 0 END)::DOUBLE / COUNT(*), 4) AS boleto_share\nFROM mg_payments\nGROUP BY period, order_date\nORDER BY period, order_date;",
 "truncated": false
}
