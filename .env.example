# Run in sample mode (local data + cached model replies). Default true for now.
SAMPLE_MODE=true
# Meterless Runtime base URL (OpenAI-compatible /v1).
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
# Older name for METERLESS_RUNTIME_TOKEN (below), used only when METERLESS_RUNTIME_TOKEN is empty.
METERLESS_API_KEY=
# NVIDIA API key for direct fallback (leave empty if unused).
NVIDIA_API_KEY=
# NVIDIA OpenAI-compatible base URL (leave empty if unused).
NVIDIA_BASE_URL=
# Unused since Sprint 2: superseded by METERLESS_MODEL / NVIDIA_MODEL below (kept for compatibility).
MODEL_NAME=
# --- Data layer (Sprint 6b) ---
# zetaris (default: the Zetaris Unified Semantic Layer over REST, falling back to local per query)
# or local (DuckDB over data/sample). SAMPLE_MODE=true always uses local and never calls Zetaris.
DATA_LAYER=zetaris
# Zetaris REST base URL ending in /api/v1.0 (leave empty to use the local DuckDB adapter).
ZETARIS_URL=
# Zetaris API key created in the Zetaris UI (Management -> API Tokens); sent as a bearer token.
ZETARIS_API_KEY=
# Numeric organisation ID (Management -> Organisation), sent as X-Org-ID on every call.
ZETARIS_ORG_ID=
# Login fallback, used when ZETARIS_API_KEY is empty or refused (GET /auth/login, Basic auth).
ZETARIS_USERNAME=
ZETARIS_PASSWORD=
# Seconds to wait before the one retry of a failed Zetaris call (connection error, timeout, 5xx).
ZETARIS_RETRY_DELAY_SECONDS=1
# Password of the four source Postgres databases; only scripts/zetaris_setup.py --start-sources and
# docker-compose.zetaris-sources.yml read it, when a source has to be created.
OLIST_PG_PASSWORD=
# Hard cap on rows returned by any data query.
MAX_QUERY_ROWS=5000
# Timeout in seconds for each data query.
QUERY_TIMEOUT_SECONDS=30
# DuckDB caps for the local adapter: memory (DuckDB size string) and worker threads.
# Keep 1 thread for repeatable results (ties in ORDER BY), which sample-mode replay depends on.
DUCKDB_MEMORY_LIMIT=2GB
DUCKDB_THREADS=1
# Folder for the DuckDB database file and its spill files. Keep it on disk, not on a RAM-backed /tmp.
DUCKDB_WORK_DIR=.cache/duckdb
# Timeout in seconds for each model call.
MODEL_TIMEOUT_SECONDS=60
# Directory for run traces and logs.
LOG_DIR=logs
# Folder with the sample CSVs (one sub-folder per source) loaded by the local DuckDB adapter.
SAMPLE_DATA_DIR=data/sample

# --- Model generator (Sprint 2) ---
# Primary provider: meterless (Nightshift) or nvidia (NVIDIA hosted API directly, no Meterless).
MODEL_PROVIDER=meterless
# Meterless Runtime token (the runtime writes it to <stateDir>/proxy-token). The placeholder rt-local is rejected.
METERLESS_RUNTIME_TOKEN=
# Meterless routing mode for every role, e.g. meterless/auto. Empty: Planner/Reporter use
# meterless/deep and Investigator/Critic use meterless/fast.
METERLESS_MODEL=
# Optional per-role overrides (win over METERLESS_MODEL).
METERLESS_MODEL_PLANNER=
METERLESS_MODEL_INVESTIGATOR=
METERLESS_MODEL_CRITIC=
METERLESS_MODEL_REPORTER=
# Model id for the direct NVIDIA fallback (needs NVIDIA_API_KEY; base URL defaults to
# https://integrate.api.nvidia.com/v1 when NVIDIA_BASE_URL is empty). Empty: no fallback.
NVIDIA_MODEL=
# Sampling temperature for every model call.
MODEL_TEMPERATURE=0.2
# Max tokens per model reply.
MAX_OUTPUT_TOKENS=4096
# Stream Meterless replies (SSE, with the usage chunk). Nightshift answers a buffered request with
# HTTP 502 provider_deadline when the reply takes longer than 45 s; false restores the buffered request.
MODEL_STREAM=true
# Retries on 429/5xx (after 2 s, 4 s, 8 s), 0-3. One agent step never sends more than 3 model requests
# in all (retries, the NVIDIA fallback and the JSON repair call together; MAX_MODEL_ATTEMPTS in code).
MAX_RETRIES=3
# In live mode, write every model reply to the per-call cache (LLM_CACHE_DIR) for sample mode.
RECORD_CACHE=false
# With RECORD_CACHE=true, replay entries already recorded with Meterless and call the model only for
# missing ones (resumes an interrupted recording, keeps tested entries). false: every call goes to the model.
RECORD_REUSE_EXISTING=true
# Per-call model reply cache used when SAMPLE_MODE=true.
LLM_CACHE_DIR=data/sample/llm_cache

# --- Investigation loop (Sprint 2) ---
# Max agent turns per run (the plan with its change check, each hypothesis, each report).
MAX_AGENT_ROUNDS=6
# Max data queries per run (a repaired query counts twice).
MAX_TOOL_CALLS=20

# --- World Model (Sprint 5) ---
# SQLite file of the World Model store (entities, edges, append-only log, ingest checkpoints).
WORLD_DB_PATH=logs/world.db
# Alert when an observation's |relative change| against its baseline reaches this (0.25 = 25 %).
ALERT_REL_CHANGE=0.25
# Alert when an observation's |robust z| against its baseline series reaches this.
ALERT_Z=3.5
# Max query rows one ingest normalises; the rest is skipped and the ingest is marked truncated.
MAX_INGEST_ROWS=5000

# --- Markovian engine (Sprint 7; sizes in characters, tokens are estimated as chars/4) ---
# Max chunks per run: chunk 1 (plan) plus one investigate-and-critique round per chunk, 1-50.
MARKOVIAN_MAX_CHUNKS=8
# Hard ceiling on the input built for one chunk (goal + carryover + evidence), 1000-200000.
MARKOVIAN_CHUNK_BUDGET_CHARS=12000
# Ceiling on the carryover state passed between chunks, 200-100000 and at most half the chunk budget.
MARKOVIAN_CARRYOVER_BUDGET_CHARS=1200
# Wall-clock limit per chunk in seconds (enforced by the orchestrator), >0 and <=3600.
MARKOVIAN_CHUNK_TIMEOUT_SECONDS=180
# Wall-clock limit for the model-compression call in the carryover cascade, >0, <=600 and <= the chunk timeout.
MARKOVIAN_COMPRESSION_TIMEOUT_SECONDS=30
# Wall-clock limit for a whole orchestrated run in seconds (stop_reason "timeout"), >0 and <=3600.
MARKOVIAN_RUN_TIMEOUT_S=540

# --- Orchestrator (Sprint 8) ---
# Investigation loop for run.py and POST /run: markovian (default, the chunked orchestrator) or simple (the Sprint 2 loop).
LOOP=markovian

# --- Critic and branches (Sprint 9) ---
# No-significant-change branch: the run ends early when |observed - baseline| <= this many spreads
# (spread = standard deviation of the measure across baseline periods as long as the window).
CHANGE_VARIATION_THRESHOLD=2.0
# Cannot-be-determined branch: the Critic flags the sample as too small below this many records
# behind the change in the window.
CRITIC_MIN_SAMPLE_SIZE=30

# --- HTTP API (Sprint 13) ---
# Bind address and port for `python -m app.api` (uvicorn app.api.main:app takes --host/--port).
API_HOST=0.0.0.0
API_PORT=8000
# Wall-clock cap on one POST /run, in seconds; past it the API answers 504 timeout.
API_RUN_TIMEOUT_SECONDS=600
# Wall-clock cap in seconds for one anomaly scan (python -m app.scanner); default 300.
SCANNER_TIMEOUT_S=300

# --- Evaluation (Sprint 11, eval/run_eval.py) ---
# Seconds one answer-key question may run before it is stopped and scored as an error.
EVAL_QUESTION_TIMEOUT_SECONDS=600
# Seconds for the whole evaluation; questions not started by then are recorded as run_cap_reached.
EVAL_TOTAL_TIMEOUT_SECONDS=3600
